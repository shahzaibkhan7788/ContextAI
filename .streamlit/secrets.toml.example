# Copy these values into Streamlit Community Cloud > App settings > Secrets.
# Use a fresh API key. Never commit the real secrets.toml file.
CONTEXTFLOW_DEMO_MODE = "true"
CONTEXTFLOW_REQUIRE_LLM = "true"
DEMO_USERNAME = "reviewer"
DEMO_PASSWORD = "replace-with-a-long-random-demo-password"

LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
LLM_API_KEY = "paste-your-new-gemini-api-key-here"
LLM_MODEL = "gemini-3.8-flash"
